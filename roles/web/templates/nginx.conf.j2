# Managed by Ansible / Gerenciado pelo Ansible
worker_processes 1;
pid /run/nginx.pid;
error_log /dev/stderr warn;
events { worker_connections 128; }
http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    access_log /dev/stdout;
    server {
        listen 8080;
        server_name _;
        root {{ lab_root }};
        index index.html;
        add_header X-Lab-Environment "{{ lab_environment }}" always;
        add_header X-Lab-Host "{{ inventory_hostname }}" always;
        location = /healthz { return 200 "ready\n"; }
        location / { try_files $uri $uri/ =404; }
    }
}
